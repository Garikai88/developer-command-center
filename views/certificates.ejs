<%- include('partials/head') %>

<body class="crt-overlay">

    <%- include('partials/loading-screen') %>
    <%- include('partials/navbar') %>

    <main class="command-center-container">

        <!-- HEADER PANEL -->
        <section class="hud-panel">
            <div class="panel-header">
                <span class="status-indicator online"></span>
                <span class="panel-title">[ ARCHIVE // CERTIFICATIONS ]</span>
            </div>

            <div class="hero-content">
                <h1 class="glitch-text" data-text="CERTIFICATION ARCHIVE">CERTIFICATION ARCHIVE</h1>
                <p class="mission-brief">> Verified credentials and completed training modules.</p>
            </div>
        </section>

        <!-- CERTIFICATE GRID -->
        <section class="hud-panel">
            <div class="quest-grid">

                <% if (certificates.length === 0) { %>
                    <p class="mission-brief">> No certifications logged yet.</p>
                <% } else { %>
                    <% certificates.forEach(cert => { %>
                        <article class="quest-card">
                            <div class="quest-badge"><%= cert.badge || 'VERIFIED' %></div>
                            <h3><%= cert.title %></h3>
                            <p><%= cert.description %></p>
                            <div class="tech-tags">
                                <span><%= cert.issuer %></span>
                                <span><%= cert.status %></span>
                            </div>
                            <a href="<%= cert.credential_url || '#' %>" target="_blank" class="quest-link">
                                <%= cert.link_label || 'VIEW CREDENTIAL' %> &rarr;
                            </a>
                        </article>
                    <% }) %>
                <% } %>

            </div>
        </section>

    </main>

    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>

</body>

