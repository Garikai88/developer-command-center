<%- include('partials/head') %>

<body class="crt-overlay">

    <%- include('partials/loading-screen') %>
    <%- include('partials/navbar') %>

    <main class="command-center-container">

        <!-- HEADER PANEL -->
        <section class="hud-panel">
            <div class="panel-header">
                <span class="status-indicator online"></span>
                <span class="panel-title">[ ARCHIVE // QUEST LOG ]</span>
            </div>

            <div class="hero-content">
                <h1 class="glitch-text" data-text="DEPLOYED MISSIONS">DEPLOYED MISSIONS</h1>
                <p class="mission-brief">> Review past missions, full-stack applications, and architectural blueprints.</p>
            </div>

        </section>

        <!-- PROJECT GRID -->
        <section class="hud-panel">
            <div class="quest-grid">

                <% if (projects.length === 0) { %>
                    <p class="mission-brief">> No missions logged yet.</p>
                <% } else { %>
                    <% projects.forEach(project => { %>
                        <article class="quest-card">
                            <div class="quest-badge"><%= project.status %></div>
                            <h3><%= project.title %></h3>
                            <p><%= project.description %></p>
                            <div class="tech-tags">
                                <% project.tech_tags.forEach(tag => { %>
                                    <span><%= tag %></span>
                                <% }) %>
                            </div>
                            <a href="<%= project.link || '#' %>" target="_blank" class="quest-link">
                                <%= project.link_label %> &rarr;
                            </a>
                        </article>
                    <% }) %>
                <% } %>

            </div>
        </section>

    </main>

    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>

</body>
